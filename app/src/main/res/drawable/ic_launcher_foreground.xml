<?xml version="1.0" encoding="utf-8"?>
<!-- Le clap, volet OUVERT au repos (-30 deg). Transcrit du SVG du brief du
     10 septembre 2026 (docs/design.md §10) ; le repos est passe de -14 a
     -30 le meme jour, sur demande du proprietaire ("un clap plus actif").
     Les rx=3 et rx=2 des rectangles sont rendus par des arcs (A) plutot que
     des coins droits : a 46 et 12 de large la difference reste visible a la
     taille reelle de l'icone.
     Tout le dessin est enveloppe dans un groupe de mise a l'echelle
     (pivot 54,54, scaleX/scaleY 0,8) pour que le masque de lanceur ne
     rogne plus la pointe du volet : sans cette echelle, le coin superieur
     droit du volet (l'extremite apres la derniere dent) est a ~41 de
     distance au centre (54,54) au repos -30 deg, hors du cercle de
     securite de 66 dp (rayon 33) ; mis a l'echelle 0,8, il tombe a ~32,9,
     dedans. Verifie aussi au point le plus lointain de toute l'animation,
     l'armement a -46 deg (res/animator/ic_launcher_volet_claque.xml) : la
     meme pointe y est a ~47,4 sans echelle, donc encore ~37,9 a l'echelle
     0,8 (et ~36,0 a 0,76, essaye pour voir) — les deux ratent le cercle de
     33. Mais ce point depassait deja le cadre de recadrage de 72 dp (rayon
     36) avant tout changement d'echelle : il etait deja integralement
     rogne, invisible, durant les 120 ms de l'armement. Rien n'est donc
     perdu de plus a l'echelle 0,8 par rapport a avant ; descendre a 0,76
     n'aurait fait que retrecir l'icone au repos sans regler ce point
     transitoire (~36,0 reste hors du cercle de 33, et quasiment sur le
     bord du cadre de 72 dp). Garde a 0,8. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.8"
        android:scaleY="0.8">
        <!-- Le corps, fixe. -->
        <path android:fillColor="#FF6B57"
            android:pathData="M34,49L74,49A3,3 0 0 1 77,52L77,73A3,3 0 0 1 74,76L34,76A3,3 0 0 1 31,73L31,52A3,3 0 0 1 34,49Z" />
        <!-- Le volet, pivot en bas a gauche (32,48). Cible de
             res/animator/ic_launcher_volet_claque.xml par son nom : ne pas
             le renommer sans mettre a jour l'animateur. La rotation ne
             change pas avec l'echelle : elle reste relative au pivot du
             groupe, lui-meme mis a l'echelle par le groupe englobant. -->
        <group
            android:name="volet"
            android:pivotX="32"
            android:pivotY="48"
            android:rotation="-30">
            <path android:fillColor="#FF6B57"
                android:pathData="M33,35L75,35A2,2 0 0 1 77,37L77,45A2,2 0 0 1 75,47L33,47A2,2 0 0 1 31,45L31,37A2,2 0 0 1 33,35Z" />
            <path android:fillColor="#000000"
                android:pathData="M39,35L46,35L41,47L34,47Z" />
            <path android:fillColor="#000000"
                android:pathData="M53,35L60,35L55,47L48,47Z" />
            <path android:fillColor="#000000"
                android:pathData="M67,35L74,35L69,47L62,47Z" />
        </group>
    </group>
</vector>
