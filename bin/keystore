#!/usr/bin/env bash
# Crée la clé de signature de la version finale, une fois. Elle vit dans
# signing/, que git ignore. LA SAUVEGARDER AILLEURS : la perdre, c'est ne plus
# pouvoir mettre l'application à jour sans la désinstaller.
set -euo pipefail
cd "$(dirname "$0")/.."
[ -e signing/release.jks ] && { echo "signing/release.jks existe déjà ; rien à faire." >&2; exit 0; }
mkdir -p signing
read -r -s -p "Mot de passe du trousseau : " mdp; echo
read -r -s -p "Encore une fois : " mdp2; echo
[ "$mdp" = "$mdp2" ] || { echo "Les deux ne correspondent pas." >&2; exit 1; }
bin/dans keytool -genkeypair -v \
  -keystore signing/release.jks -storepass "$mdp" -keypass "$mdp" \
  -alias journal -keyalg RSA -keysize 2048 -validity 10000 \
  -dname "CN=Journal, O=Mediatheque"
cat > signing/release.properties <<EOF
keystore.path=signing/release.jks
keystore.password=$mdp
key.alias=journal
key.password=$mdp
EOF
chmod 600 signing/release.properties
echo "Clé créée. Copie le dossier signing/ dans un endroit sûr, maintenant."
