#!/usr/bin/env bash
# Crée la clé de signature de la version finale, une fois. Elle vit dans
# signing/, que git ignore. LA SAUVEGARDER AILLEURS : la perdre, c'est ne plus
# pouvoir mettre l'application à jour sans la désinstaller.
set -euo pipefail
cd "$(dirname "$0")/.."

if [ -e signing/release.jks ]; then
  if [ -e signing/release.properties ]; then
    echo "signing/release.jks existe déjà ; rien à faire." >&2
    exit 0
  fi
  echo "signing/release.jks existe mais signing/release.properties manque : la variante release ne trouvera pas le mot de passe et refusera de compiler." >&2
  echo "Recrée-le à la main (keystore.path=signing/release.jks, keystore.password, key.alias=journal, key.password), avec le mot de passe donné à la création de la clé — ou supprime signing/release.jks et relance bin/keystore pour tout regénérer." >&2
  exit 1
fi

mkdir -p signing
read -r -s -p "Mot de passe du trousseau : " mdp; echo
read -r -s -p "Encore une fois : " mdp2; echo
[ "$mdp" = "$mdp2" ] || { echo "Les deux ne correspondent pas." >&2; exit 1; }

# Le mot de passe ne passe jamais en argument de `docker compose run` : la ligne de commande
# entière reste visible dans `ps` sur le poste, le temps de la commande. `-e
# RELEASE_KEYSTORE_PASSWORD` (sans `=valeur`) ne transmet au conteneur que le NOM de la variable,
# sa valeur restant dans l'environnement du shell ; `keytool` la lit par `-storepass:env` /
# `-keypass:env`, jamais en clair sur sa ligne de commande à lui non plus.
export RELEASE_KEYSTORE_PASSWORD="$mdp"
docker compose run --rm -e RELEASE_KEYSTORE_PASSWORD android keytool -genkeypair -v \
  -keystore signing/release.jks -storepass:env RELEASE_KEYSTORE_PASSWORD -keypass:env RELEASE_KEYSTORE_PASSWORD \
  -alias journal -keyalg RSA -keysize 2048 -validity 10000 \
  -dname "CN=Journal, O=Mediatheque"

cat > signing/release.properties <<EOF
keystore.path=signing/release.jks
keystore.password=$mdp
key.alias=journal
key.password=$mdp
EOF
chmod 600 signing/release.properties signing/release.jks
echo "Clé créée. Copie le dossier signing/ dans un endroit sûr, maintenant."
